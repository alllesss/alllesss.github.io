---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="page-head">
    <div>
      <p class="label is-accent" style="margin-bottom: 14px">Error 404</p>
      <h1 class="page-title">Nothing is loaded here.</h1>
      <p class="page-sub">This page does not exist, or it has moved.</p>
      <p style="margin-top: 28px"><a class="btn btn--accent" href="/">Back to the process log</a></p>
    </div>
  </div>
</Base>
