---
import Base from '../layouts/Base.astro';
import Thumb from '../components/Thumb.astro';
import { getPosts, isoDate } from '../lib/posts';
import { pinned } from '../data/pinned';

const posts = await getPosts();
const first = posts[posts.length - 1];
const latest = posts[0];
const today = isoDate(new Date());
const cards = pinned.filter((p) => p.show !== false && (!p.until || today <= p.until));

const OWNER = 'Ali Eslami';
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const kindOf = (p: (typeof posts)[number]) =>
  p.data.author !== OWNER ? 'essay' : p.data.type && p.data.type !== 'Residency' ? 'event' : 'devlog';
const KINDS = [
  ['all', 'Everything'],
  ['devlog', 'Devlogs'],
  ['essay', 'Essays'],
  ['event', 'Events'],
] as const;
const counts: Record<string, number> = { all: posts.length };
for (const p of posts) counts[kindOf(p)] = (counts[kindOf(p)] ?? 0) + 1;

// The space above each entry follows the real time since the entry before it (square-root scaled):
// bursts of work sit close together, long quiet stretches open up. site.ts recomputes this when filtering.
const DAY = 86_400_000;
const gapFor = (days: number) => Math.round(Math.min(150, Math.max(12, Math.sqrt(days) * 7)));
let prev = { iso: today, year: today.slice(0, 4) };
const rows = posts.map((p, i) => {
  const iso = isoDate(p.data.date);
  const year = iso.slice(0, 4);
  const days = Math.round((Date.parse(prev.iso) - Date.parse(iso)) / DAY);
  const showYear = i === 0 || year !== prev.year;
  const gap = showYear ? Math.max(gapFor(days), 52) : gapFor(days);
  prev = { iso, year };
  const d = p.data.date;
  return {
    p,
    iso,
    year,
    showYear,
    gap,
    kind: kindOf(p),
    day: `${MONTHS[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, '0')}`,
    type: p.data.type ?? (p.data.author !== OWNER ? 'Essay' : 'Devlog'),
    guest: p.data.author !== OWNER ? p.data.author : undefined,
    event: Boolean(p.data.type),
  };
});
---
<Base>
<div class="home">
  <div class="page-head">
    <div>
      <h1 class="page-title">Process Log</h1>
      <p class="page-sub">Working notes from an ongoing simulation.</p>
    </div>
    <p class="label">{posts.length} entries · {first.data.date.getUTCFullYear()} — {latest.data.date.getUTCFullYear()}</p>
  </div>

  {cards.length > 0 && (
    <section class="pinned" aria-label="Pinned">
      {cards.map((card) => (
        <a class:list={['pin glass', card.live && 'is-live']} href={card.link.href}>
          <span><span class:list={['badge', card.live && 'badge--accent']}>{card.live && <span class="pulse" aria-hidden="true" />}{card.status}</span></span>
          <strong class="pin-title">{card.title}</strong>
          <span class="pin-text">{card.text}</span>
          <span class="pin-link label">{card.link.label} ›</span>
        </a>
      ))}
    </section>
  )}

  <div class="archive-bar">
    <h2 class="label">Archive</h2>
    <span class="archive-rule" aria-hidden="true"></span>
    <div class="chips" role="group" aria-label="Show">
      {KINDS.map(([k, label]) => (
        <button type="button" class="chip" data-filter={k} aria-pressed={k === 'all' ? 'true' : 'false'}>
          {label} <span class="chip-n">{counts[k] ?? 0}</span>
        </button>
      ))}
    </div>
  </div>

  <ol class="timeline" role="list" data-now={today}>
    <li class="tl-now" aria-hidden="true">
      <span class="tl-date is-accent">Now</span><span class="tl-axis"><span class="tl-dot tl-dot--now"></span></span><span></span>
    </li>
    {rows.map((r) => (
      <li class="tl-row" data-kind={r.kind} data-iso={r.iso} data-year={r.year} style={`--gap: ${r.gap}px`}>
        <div class="tl-gap" aria-hidden="true">
          <span class="tl-year" hidden={!r.showYear}>{r.year}</span><span class="tl-axis"></span><span></span>
        </div>
        <div class="tl-entry">
          <time class="tl-date" datetime={r.iso}>{r.day}</time>
          <span class="tl-axis" aria-hidden="true"><span class:list={['tl-dot', r.event && 'tl-dot--event']}></span></span>
          <a class="entry glass" href={`/${r.p.id}/`}>
            <span class="entry-text">
              <span class="entry-title">{r.p.data.title}</span>
              {r.p.data.subtitle && <span class="entry-sub">{r.p.data.subtitle}</span>}
              <span class="entry-foot">
                <span class="entry-by">{r.guest && <Fragment>By <span class="entry-guest">{r.guest}</span></Fragment>}</span>
                <span class="entry-type">{r.type}</span>
              </span>
            </span>
            <span class="entry-media">
              <Thumb src={r.p.data.thumbnail ?? r.p.data.cover} sizes="(max-width: 640px) 112px, 228px" widths={[240, 480]} />
            </span>
          </a>
        </div>
      </li>
    ))}
    <li class="tl-end">
      <span></span><span class="tl-axis tl-axis--end" aria-hidden="true"><span class="tl-dot tl-dot--end"></span></span>
      <span class="tl-end-text">The log begins, {first.data.date.toLocaleString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' })}.</span>
    </li>
  </ol>
</div>
</Base>

<script>
  // Filters: show one kind of entry, then re-space the timeline by real time among what's visible.
  const list = document.querySelector<HTMLElement>('.timeline');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  if (list && chips.length) {
    const rows = [...list.querySelectorAll<HTMLElement>('.tl-row')];
    const now = list.dataset.now ?? new Date().toISOString().slice(0, 10);
    const gapFor = (days: number) => Math.round(Math.min(150, Math.max(12, Math.sqrt(days) * 7)));
    const apply = (kind: string) => {
      let prevIso = now;
      let prevYear = now.slice(0, 4);
      let first = true;
      for (const row of rows) {
        const on = kind === 'all' || row.dataset.kind === kind;
        row.hidden = !on;
        if (!on) continue;
        const iso = row.dataset.iso!;
        const year = row.dataset.year!;
        const days = Math.round((Date.parse(prevIso) - Date.parse(iso)) / 86_400_000);
        const showYear = first || year !== prevYear;
        row.style.setProperty('--gap', `${showYear ? Math.max(gapFor(days), 52) : gapFor(days)}px`);
        row.querySelector<HTMLElement>('.tl-year')!.hidden = !showYear;
        prevIso = iso;
        prevYear = year;
        first = false;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === kind)));
    };
    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter ?? 'all')));
  }
</script>

<style>
  .home { max-width: 58rem; margin: 0 auto; }
  .page-head { padding-bottom: 36px; }

  /* ---- pinned ---- */
  .pinned { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--gap-tile); }
  .pin {
    display: flex; flex-direction: column; gap: 12px; padding: 22px 24px; color: inherit;
    transition: transform var(--dur-normal) var(--ease-standard), box-shadow var(--dur-normal) var(--ease-standard), border-color var(--dur-normal) var(--ease-standard);
  }
  .pin > * { position: relative; z-index: 1; }
  .pin.is-live { border-color: rgba(218, 112, 44, 0.55); }
  .pin:hover { color: inherit; transform: translateY(-2px); box-shadow: var(--shadow-lg); border-color: rgba(218, 112, 44, 0.55); }
  .pin-title { font-family: var(--font-display); font-weight: 600; font-size: 24px; line-height: 1.2; color: var(--text-bright); }
  .pin:hover .pin-title { color: var(--accent-hover); }
  .pin-text { font-size: 15px; line-height: 1.5; color: var(--text-muted); }
  .pin-link { margin-top: auto; padding-top: 4px; color: var(--accent); }
  .pulse { width: 6px; height: 6px; border-radius: 999px; background: currentColor; animation: pulse 2.4s var(--ease-standard) infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }

  /* ---- archive bar + filter pills ---- */
  .archive-bar { display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap; margin: 56px 0 8px; }
  .archive-bar h2 { margin: 0; }
  .archive-rule { flex: 1; min-width: 24px; border-top: 1px solid var(--border-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex; gap: 6px; align-items: baseline; padding: 6px 14px; border-radius: 999px; cursor: pointer;
    font: 14px/1.3 var(--font-body); color: var(--text-body); background: transparent; border: 1px solid rgba(206, 205, 195, 0.22);
    transition: background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }
  .chip:hover { border-color: var(--border-frame); color: var(--text-bright); }
  .chip[aria-pressed='true'] { background: var(--text-bright); border-color: var(--text-bright); color: var(--surface-void); }
  .chip-n { font-size: 12px; opacity: 0.6; }

  /* ---- timeline ---- */
  .timeline { list-style: none; margin: 0; padding: 0; --date-col: 84px; --axis-col: 32px; }
  .tl-now, .tl-gap, .tl-entry, .tl-end { display: grid; grid-template-columns: var(--date-col) var(--axis-col) minmax(0, 1fr); align-items: center; }
  .tl-now { height: 40px; }
  .tl-gap { height: var(--gap, 24px); }
  .tl-row[hidden] { display: none; }
  .tl-year[hidden] { display: block; visibility: hidden; } /* keep its grid cell so the line stays aligned */
  .tl-date { text-align: right; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .tl-year { text-align: right; font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: 0.02em; color: var(--text-bright); }
  .tl-axis { position: relative; align-self: stretch; }
  .tl-axis::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: rgba(206, 205, 195, 0.22); }
  .tl-now .tl-axis::before { top: 50%; }
  .tl-axis--end::before { bottom: 50%; }
  .tl-dot { position: absolute; left: 50%; top: 50%; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 999px; background: var(--text-muted); }
  .tl-dot--event { width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; background: var(--accent); box-shadow: 0 0 12px rgba(218, 112, 44, 0.55); }
  .tl-dot--now { width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; background: var(--accent); box-shadow: 0 0 12px rgba(218, 112, 44, 0.55); }
  .tl-dot--end { background: rgba(206, 205, 195, 0.22); }
  .tl-end { height: 56px; }
  .tl-end-text { padding-left: 8px; font-size: 15px; font-style: italic; color: var(--text-muted); }

  /* ---- entry tiles ---- */
  .entry {
    display: flex; align-items: center; gap: 20px; margin-left: 8px; padding: 8px 8px 8px 20px; min-width: 0; color: inherit;
    transition: transform var(--dur-normal) var(--ease-standard), box-shadow var(--dur-normal) var(--ease-standard), border-color var(--dur-normal) var(--ease-standard);
  }
  .entry > * { position: relative; z-index: 1; }
  .entry:hover { color: inherit; transform: translateY(-2px); box-shadow: var(--shadow-lg); border-color: rgba(218, 112, 44, 0.55); }
  .entry-text { flex: 1 1 auto; min-width: 0; align-self: stretch; display: flex; flex-direction: column; gap: 6px; padding: 8px 0 6px; }
  .entry-title { font-family: var(--font-display); font-weight: 500; font-size: 22px; line-height: 1.22; color: var(--accent); transition: color var(--dur-normal); }
  .entry:hover .entry-title { color: var(--flexoki-orange-200); }
  .entry-sub { font-size: 14px; line-height: 1.45; color: var(--text-muted); }
  .entry-foot { margin-top: auto; padding-top: 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px 12px; flex-wrap: wrap; }
  .entry-by { font-size: 14px; color: var(--text-muted); }
  .entry-guest { font-weight: 500; color: var(--flexoki-red-300); }
  .entry-type {
    padding: 2px 9px; border-radius: 999px; box-shadow: inset 0 0 0 1px rgba(206, 205, 195, 0.22);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted);
  }
  .entry-media { flex: 0 0 228px; width: 228px; aspect-ratio: 3 / 2; border-radius: 10px; overflow: hidden; background: var(--surface-inset); position: relative; }
  .entry-media :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
    filter: saturate(0.92) brightness(0.94);
    transition: filter var(--dur-slow) var(--ease-standard), transform var(--dur-slow) var(--ease-emerge);
  }
  .entry:hover .entry-media :global(img) { filter: none; transform: scale(1.03); }

  @media (max-width: 640px) {
    .timeline { --date-col: 40px; --axis-col: 18px; }
    .tl-date { font-size: 10px; letter-spacing: 0.02em; white-space: normal; line-height: 1.3; }
    .tl-year { font-size: 16px; }
    .entry { gap: 12px; padding: 6px 6px 6px 12px; margin-left: 4px; }
    .entry-title { font-size: 17px; }
    .entry-sub { font-size: 13px; }
    .entry-media { flex-basis: 104px; width: 104px; }
    .entry-foot { padding-top: 6px; }
  }
</style>
