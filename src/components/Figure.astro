---
// An image with an optional caption. Used in posts as:
//   <Figure src="https://…/image.jpg" alt="…" caption="…" />
// Options: size="medium" | "small", or width="70%" / width="400px" for a custom maximum width.
// Remote originals are resized to several widths in AVIF + WebP at build time.
import { Picture } from 'astro:assets';
import { imageMeta, widthsFor, FORMATS, FALLBACK } from '../lib/images';

interface Props { src: string; alt?: string; caption?: string; size?: 'medium' | 'small'; width?: string; priority?: boolean }
const { src, alt = '', caption, size, width, priority = false } = Astro.props;
const meta = imageMeta(src);
const optimise = meta && !meta.animated && !/\.(svg|gif)$/i.test(src);
const hasCaption = Boolean(caption) || Astro.slots.has('default');
// How wide the image is drawn, so the browser can pick the smallest file that still looks sharp.
const drawn = size === 'small' ? '480px' : size === 'medium' ? '680px' : '880px';
const sizes = `(min-width: 1100px) ${drawn}, 100vw`;
// Tall (portrait) images are capped so they never grow taller than the screen.
const portrait = meta && meta.h > meta.w * 1.05 ? `max-width: min(100%, ${Math.round((760 * meta.w) / meta.h)}px);` : '';
const custom = width ? `max-width: ${/^\d+$/.test(width) ? width + 'px' : width}; margin-inline: auto;` : '';
const style = custom || portrait || undefined;
---
<figure class:list={['fig', size && `fig--${size}`, !style && !size && 'fig--auto']} style={style}>
  <span class="fig-frame" data-zoom style={meta ? `--ph: ${meta.color}` : undefined}>
    {optimise ? (
      <Picture
        src={src}
        alt={alt}
        width={meta.w}
        height={meta.h}
        widths={widthsFor(meta.w)}
        sizes={sizes}
        formats={[...FORMATS]}
        fallbackFormat={FALLBACK}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <img src={src} alt={alt} width={meta?.w} height={meta?.h} loading="lazy" decoding="async" />
    )}
  </span>
  {hasCaption && <figcaption>{caption}<slot /></figcaption>}
</figure>
