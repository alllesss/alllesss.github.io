---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  bare?: boolean; // no navigation or footer (the /stay and /links pages)
}
const SITE = 'ESHRAQ';
const {
  title,
  description = 'ESHRAQ process log: working notes from an ongoing simulation by Ali Eslami.',
  image,
  type = 'website',
  bare = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : `${SITE} — Process Log`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Blog', current: path === '/' || /^\/\d{4}-/.test(path) },
  { href: '/foundations/', label: 'Foundations', current: path.startsWith('/foundations') },
  { href: '/about/', label: 'About', current: path.startsWith('/about') },
  { href: '/stay/', label: 'Stay in touch', current: path.startsWith('/stay'), icon: 'mail' },
];
const GTAG = 'G-CX3VKN2EYV';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ali Eslami" />
    <meta name="theme-color" content="#211f1c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="ESHRAQ — Process Log" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? `${SITE} — Process Log`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG}`}></script>
        <script is:inline define:vars={{ GTAG }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GTAG);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <Wordmark />
        {!bare && (
          <nav class="site-nav" aria-label="Main">
            {nav.map((n) => (
              <a href={n.href} class:list={[n.icon && 'nav-mail']} aria-current={n.current ? 'page' : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
        )}
      </header>

      <main id="main">
        <slot />
      </main>

      {!bare && (
        <footer class="site-footer">
          <div class="colophon data">
            <span>ESHRAQ · <span class="farsi" lang="fa">اشراق</span></span>
            <span class="faint">/</span>
            <span>© 2023–{new Date().getFullYear()} Ali Eslami</span>
            <span class="faint">/</span>
            <span>A project of <a href="https://alllesss.com" target="_blank" rel="noopener">ALLLESSS</a></span>
          </div>
          <nav class="data" aria-label="Footer">
            <a href="/links/">Links</a>
            <a href="/stay/" class="footer-sub">Subscribe</a>
            <a href="https://instagram.com/alless0" target="_blank" rel="noopener">@alless0</a>
          </nav>
        </footer>
      )}
    </div>

    <dialog class="lightbox" aria-label="Image viewer" tabindex="-1">
      <span class="lb-count" aria-live="polite"></span>
      <button class="lb-btn lb-close" type="button" aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      <button class="lb-btn lb-prev" type="button" aria-label="Previous image"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
      <button class="lb-btn lb-next" type="button" aria-label="Next image"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      <div class="lb-stage"><img class="lb-img" alt="" /></div>
      <p class="lb-cap"></p>
    </dialog>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
