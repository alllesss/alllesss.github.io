---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  bare?: boolean; // no navigation or footer (for a page that should stand on its own; none uses it now)
  published?: Date; // a post's date, for the structured data
}
const SITE = 'ESHRAQ';
const {
  title,
  description = 'ESHRAQ process log: working notes from an ongoing simulation by Ali Eslami.',
  // Pages without their own image (the home page, About, Foundations…) share ESHRAQ's main image.
  image = new URL('/img/og-eshraq.jpg', Astro.site).href,
  type = 'website',
  bare = false,
  published,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE}` : `${SITE} — Process Log`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Blog', current: path === '/' || /^\/\d{4}-/.test(path) },
  { href: '/foundations/', label: 'Foundations', current: path.startsWith('/foundations') },
  { href: '/about/', label: 'About', current: path.startsWith('/about') },
  { href: '/stay/', label: 'Stay in touch', current: path.startsWith('/stay'), icon: 'mail' },
];
const GTAG = 'G-CX3VKN2EYV';
// Structured data for search engines (invisible on the page): who makes ESHRAQ, what it is, and on posts, who wrote them.
const AUTHOR = {
  '@type': 'Person',
  '@id': 'https://www.alllesss.com/#ali-eslami',
  name: 'Ali Eslami',
  alternateName: 'ALLLESSS',
  url: 'https://www.alllesss.com/',
  sameAs: ['https://www.instagram.com/alless0', 'https://www.linkedin.com/in/alllesss', 'https://vimeo.com/alllesss', 'https://www.youtube.com/@alless0', 'https://alllesss.itch.io/'],
};
const GAME = {
  '@type': 'VideoGame',
  '@id': 'https://www.eshraq.io/#game',
  name: 'ESHRAQ',
  url: 'https://www.eshraq.io/',
  description: 'If the 12th-century philosopher Suhrawardi had a computer, what would he build? A simulated world of light and knowledge, developed in the open.',
  gamePlatform: 'PC',
  applicationCategory: 'Game',
  author: AUTHOR,
  sameAs: ['https://store.steampowered.com/app/4869850/ESHRAQ/', 'https://www.alllesss.com/projects/eshraq/'],
};
const SITE_LD = { '@type': 'WebSite', '@id': 'https://www.eshraq.io/#website', name: 'ESHRAQ', alternateName: 'ESHRAQ Process Log', url: 'https://www.eshraq.io/', about: { '@id': GAME['@id'] }, author: { '@id': AUTHOR['@id'] } };
const graph =
  path === '/' ? [{ ...GAME, image }, SITE_LD]
  : type === 'article' ? [{
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical.href,
      image,
      ...(published ? { datePublished: published.toISOString().slice(0, 10) } : {}),
      author: AUTHOR,
      about: { '@type': 'VideoGame', '@id': GAME['@id'], name: 'ESHRAQ' },
      isPartOf: { '@id': SITE_LD['@id'] },
    }]
  : [];
const ld = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }) : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ali Eslami" />
    <meta name="theme-color" content="#211f1c" />
    <link rel="canonical" href={canonical} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="ESHRAQ — Process Log" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={title ?? `${SITE} — Process Log`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG}`}></script>
        <script is:inline define:vars={{ GTAG }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GTAG);
        </script>
        {/* Cloudflare Web Analytics: cookieless visit counts (Cloudflare account, Web analytics → eshraq.io). */}
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "7c30f9d55bad43ac82663f2dbc230a94"}'></script>
      </Fragment>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <Wordmark />
        {!bare && (
          <nav class="site-nav" aria-label="Main">
            {nav.map((n) => (
              <a href={n.href} class:list={[n.icon && 'nav-mail']} aria-current={n.current ? 'page' : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
        )}
      </header>

      <main id="main">
        <slot />
      </main>

      {!bare && (
        <footer class="site-footer">
          <div class="colophon data">
            <span>ESHRAQ · <span class="footer-farsi" lang="fa" dir="rtl">اشـــراق</span></span>
            <span class="faint">/</span>
            <span>© 2023–{new Date().getFullYear()} Ali Eslami</span>
            <span class="faint">/</span>
            <span>A project of <a href="https://alllesss.com" target="_blank" rel="noopener">ALLLESSS</a></span>
          </div>
          <nav class="data" aria-label="Footer">
            <a href="/stay/" class="footer-sub">Subscribe</a>
            <a href="https://instagram.com/alless0" target="_blank" rel="noopener">@alless0</a>
          </nav>
        </footer>
      )}
    </div>

    <dialog class="lightbox" aria-label="Image viewer" tabindex="-1">
      <span class="lb-count" aria-live="polite"></span>
      <button class="lb-btn lb-close" type="button" aria-label="Close"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      <button class="lb-btn lb-prev" type="button" aria-label="Previous image"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
      <button class="lb-btn lb-next" type="button" aria-label="Next image"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      <div class="lb-stage"><img class="lb-img" alt="" /></div>
      <p class="lb-cap"></p>
    </dialog>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
